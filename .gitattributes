# Keep line endings exactly as committed. Without this, a global core.autocrlf
# rewrites every file on checkout and the next commit shows whole-file diffs
# that hide the real change — which is precisely what happened while this code
# was being fixed.
* text=auto eol=lf
# ...except Windows scripts, which the command prompt reads most reliably with CRLF
*.cmd text eol=crlf
*.ps1 text eol=crlf
# ...and the Mac setup, which bash reads only with LF
*.command text eol=lf

# Binary
*.png binary
*.docx binary
*.xlsx binary
*.potx binary
*.dotx binary
*.ttf binary
